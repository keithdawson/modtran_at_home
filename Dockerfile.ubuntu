# Dockerfile for Ubuntu 24.04 / 22.04 LTS (Air-Gapped Offline Compatible)
FROM ubuntu:24.04

LABEL maintainer="modtran_at_home"
LABEL description="MODTRAN-at-home offline execution environment for Ubuntu"

# Prevent interactive prompts during apt install
ENV DEBIAN_FRONTEND=noninteractive

# Install Python 3.12/3.11, pip, and system utilities
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
        python3-dev \
        build-essential \
        procps \
        ca-certificates && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy offline wheels, data, and application source
COPY wheels /app/wheels
COPY data /app/data
COPY pyproject.toml README.md CONTRACT.md /app/
COPY mwir_atmos /app/mwir_atmos
COPY scenarios /app/scenarios
COPY tests /app/tests

# Create virtual environment and install dependencies strictly offline from local wheels
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --no-cache-dir --upgrade pip --no-index --find-links /app/wheels wheel setuptools && \
    pip install --no-cache-dir --no-index --find-links /app/wheels -e ".[gui,dev]"

# Environment variables
ENV PYTHONUNBUFFERED=1

# Streamlit Web GUI port
EXPOSE 8501

# Default command runs the test suite
CMD ["pytest", "tests/", "-v"]
